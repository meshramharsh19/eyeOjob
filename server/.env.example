PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

GROQ_API_KEY=
# llama-3.1-8b-instant was retired from Groq's catalog (2026-09) — gpt-oss-20b verified working
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Most free OpenRouter models rotate in/out of upstream rate-limiting — verify
# at openrouter.ai/models if this one starts 429ing
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Hugging Face: create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Cerebras, Mistral, SambaNova, GitHub Models, and NVIDIA NIM were tried and
# removed entirely (2026-09) — none can work under a free/no-card setup
# (payment-method walls, product retirement, or mass model end-of-life).
# See ai.extractor.js's chain-order comment if re-evaluating any of them.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=eyeOjob
DB_PORT=3306

MAIL_USER=
MAIL_PASS=

JWT_SECRET=
JWT_EXPIRES=7d

# Auth rate limiting — all optional, defaults shown are applied in
# config/rateLimit.js if unset. IP-level limits use express-rate-limit
# (middlewares/rateLimiter.middleware.js); the login-failure pair below is a
# separate MySQL-backed account-level counter (see login-failure.repository.js).
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_MINUTES=15
AUTH_REGISTER_RATE_LIMIT=10
AUTH_REGISTER_RATE_WINDOW_MINUTES=60
AUTH_OTP_VERIFY_RATE_LIMIT=5
AUTH_OTP_VERIFY_RATE_WINDOW_MINUTES=10
AUTH_OTP_SEND_RATE_LIMIT=3
AUTH_OTP_SEND_RATE_WINDOW_MINUTES=10
AUTH_FORGOT_PASSWORD_RATE_LIMIT=3
AUTH_FORGOT_PASSWORD_RATE_WINDOW_MINUTES=15
AUTH_RESET_OTP_SEND_RATE_LIMIT=3
AUTH_RESET_OTP_SEND_RATE_WINDOW_MINUTES=10
AUTH_RESET_OTP_VERIFY_RATE_LIMIT=5
AUTH_RESET_OTP_VERIFY_RATE_WINDOW_MINUTES=10
AUTH_RESET_PASSWORD_RATE_LIMIT=5
AUTH_RESET_PASSWORD_RATE_WINDOW_MINUTES=15
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_MINUTES=15

# How long a sync can sit in status='syncing' before it's treated as stuck
# (e.g. the server crashed mid-sync) and becomes eligible for reclaim/retry.
# See config/syncStatus.js.
SYNC_STUCK_TIMEOUT_MINUTES=15

# How many users' syncs the automatic scheduler runs concurrently, as a
# continuous worker pool (not fixed-size batches). See config/env.js and
# pipelines/email-pipeline/ingestion/scheduler.js.
SCHEDULER_CONCURRENCY=10

# BYOK hybrid AI provider architecture — see Project DOCs/BYOK.md.
# Master key for encrypting user-supplied AI provider API keys at rest
# (AES-256-GCM). MUST be exactly 32 bytes as a 64-char hex string. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required only once a user actually connects a BYOK provider key — the
# server boots fine without it until then, but connecting a key will fail.
AI_CREDENTIAL_ENCRYPTION_KEY=
# Monthly AI-call allowance for users on the free tier (no BYOK key, no paid
# plan). See config/env.js.
AI_FREE_MONTHLY_CAP=150
# Per-user rate limits on /ai/providers/:provider/connect|validate and
# /ai/providers/:id/test — each hits a live external provider API, so these
# are capped independently of the general auth limiters. See config/rateLimit.js.
AI_PROVIDER_CONNECT_RATE_LIMIT=5
AI_PROVIDER_CONNECT_RATE_WINDOW_MINUTES=1
AI_PROVIDER_VALIDATE_RATE_LIMIT=5
AI_PROVIDER_VALIDATE_RATE_WINDOW_MINUTES=1
