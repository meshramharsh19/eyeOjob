# ================================
# Root .gitignore
# ================================

# Node Modules
node_modules/
**/node_modules/

# Environment Files
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime files
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/

# Build folders
dist/
build/

# Cache
.cache/
.parcel-cache/
.vite/

# OS Files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp


# Ignore local uploads if any
uploads/

# Database dumps/backups
db_backup/
